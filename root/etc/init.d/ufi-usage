#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ufi-usage

start_service() {
	[ -x "$PROG" ] || return 1

	procd_open_instance
	procd_set_param command /usr/bin/python3 "$PROG" autologin-daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
