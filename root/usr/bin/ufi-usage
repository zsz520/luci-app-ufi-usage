                    {
                        "elemType": "3",
                        "flowType": "1",
                        "feePolicyId": "ordinary-2",
                        "feePolicyName": "普通测试包 2",
                        "use": "1024",
                        "remain": "1024",
                    },
                ]
            },
        },
        {"curntbalancecust": "9.50", "realfeecustnew": "12.34"},
        "13100131000",
    )
    assert unicom_usage["flow"]["general_remaining_gb"] == 4.0
    assert unicom_usage["flow"]["directed_unlimited"] is True
    assert len(unicom_usage["packages"]) == 3
    assert unicom_usage["packages"][0]["unlimited"] is True
    assert unicom_usage["packages"][0]["sharing"] == "unshared"
    assert any(
        item["name"].startswith("相同测试包") and item["sharing"] == "shared"
        for item in unicom_usage["packages"]
    )
    assert unicom_usage["balance_yuan"] == 9.5
    assert unicom_usage["current_spend_yuan"] == 12.34
    assert unicom_usage["plan_name"] == "测试主套餐"
    assert unicom_usage["owner_name"] == "测试机主"
    assert unicom_usage["family_member_count"] == 1
    assert unicom_usage["family_members"][0]["number_masked"] == "131****1000"
    assert unicom_usage["contract_days"] > 0
    assert unicom_usage["monthly_rebate_yuan"] == 20
    assert unicom_usage["speed_limit_gb"] == 20.0

    cloud_usage = parse_cloud_usage(
        "cloud",
