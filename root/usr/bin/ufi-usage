    assert cloud_usage["flow"]["general_remaining_gb"] == 3.0
    assert cloud_usage["cloud_card"]["provider_name"] == "云上卡"

    sample = {"test": "敏感数据✓"}
    encrypted = encrypt_secret(sample)
    assert decrypt_secret(encrypted) == sample
    _, mobile_headers = mobile_envelope("/selftest", {"cellNum": "13800138000"})
    token_plain = openssl_aes(
        mobile_headers["x-token"].encode("ascii"), MOBILE_REQ_KEY, decrypt=True
    ).decode("utf-8")
    assert re.fullmatch(r"[0-9a-f]{32}_/selftest_\d{13}_\d{8}", token_plain)
    rsa_ciphertext = base64.b64decode(unicom_rsa("13100131000"))
    assert len(rsa_ciphertext) == 128
    mini_ciphertext = base64.b64decode(
        unicom_mini_rsa("test-token" + "oFroJ0ZkvVVZPkAIA0AV5wRU2eOY")
    )
    assert len(mini_ciphertext) == 256
    web_login_ciphertext = base64.b64decode(unicom_web_rsa("13100131000"))
    assert len(web_login_ciphertext) == 128
    web_device_id = unicom_web_device_id()
    assert re.fullmatch(r"[a-z0-9]{16}", web_device_id)
    web_params = unicom_web_base_params(web_device_id)
    assert web_params["deviceId"] == web_device_id
    assert web_params["version"] == "iphone_c@13.1000"
    assert "138****8000" in safe_message("账号 13800138000 已登录")
    return {
        "ok": True,
        "version": APP_VERSION,
        "parsers": ["mobile", "unicom", "cloud", "xj"],
        "crypto": ["mobile-aes", "unicom-rsa", "unicom-web-rsa"],
        "storage_encryption": True,
    }


def doctor() -> dict:
    ensure_data_dir()
    result = {
        "ok": True,
        "version": APP_VERSION,
        "python": sys.version.split()[0],
        "dependencies": {},
        "storage": {},
    }
    for command in ("openssl", "ubus", "logger"):
        result["dependencies"][command] = bool(shutil.which(command))
    result["dependencies"]["luci_controller"] = Path(
        "/usr/lib/lua/luci/controller/ufi_usage.lua"
    ).exists()
    result["dependencies"]["smsd"] = any(
        "mu300-smsd" in command
        for command in (
            _read_cmdline(path)
            for path in Path("/proc").glob("[0-9]*/cmdline")
        )
        if command
    )
    result["storage"] = {
        "path": str(DATA_DIR),
        "mode": oct(DATA_DIR.stat().st_mode & 0o777),
        "state_mode": oct(STATE_FILE.stat().st_mode & 0o777)
        if STATE_FILE.exists()
        else None,
        "key_mode": oct(KEY_FILE.stat().st_mode & 0o777)
        if KEY_FILE.exists()
        else None,
    }
    result["ok"] = all(bool(value) for value in result["dependencies"].values())
    return result


def _read_cmdline(path: Path) -> str:
    try:
        return path.read_bytes().replace(b"\0", b" ").decode("utf-8", "ignore")
    except OSError:
        return ""


def print_json(value: Any) -> None:
    sys.stdout.write(
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    )


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: ufi-usage api FILE | selftest | doctor | autologin-daemon | autologin-once ID")
        return 2
    command = argv[1]
    if command == "api" and len(argv) == 3:
        return api_main(argv[2])
    if command == "selftest":
        print_json(selftest())
        return 0
    if command == "doctor":
        print_json(doctor())
        return 0
    if command == "autologin-daemon":
        auto_daemon()
        return 0
    if command == "autologin-once" and len(argv) == 3:
        try:
            result = auto_login_once(argv[2], manual=True)
            print_json({"ok": True, **result})
            return 0
        except UserError as error:
            print_json({"ok": False, "error": clean_text(error, 220)})
            return 1
    print("unknown command", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
